{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governed Action Decision",
  "type": "object",
  "required": ["action", "target", "risk", "capabilities", "decision", "reason"],
  "properties": {
    "action": {"type": "string"},
    "target": {"type": "string"},
    "risk": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "capabilities": {"type": "array", "items": {"type": "string"}},
    "decision": {"enum": ["allow", "allow_with_evidence", "require_approval", "deny"]},
    "reason": {"type": "string"},
    "approval_reference": {"type": ["string", "null"]},
    "required_evidence": {"type": "array", "items": {"type": "string"}}
  }
}
