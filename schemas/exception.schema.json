{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governance Exception Record",
  "type": "object",
  "required": ["control_id", "scope", "reason", "approved_by", "issued_at", "expires_at", "compensating_controls"],
  "properties": {
    "control_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string"},
    "expires_at": {"type": "string"},
    "compensating_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": ["string", "null"]}
  }
}
