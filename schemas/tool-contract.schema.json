{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlimangoStudio/Alimango-ai-governance/schemas/tool-contract.schema.json",
  "title": "Agent Tool Contract",
  "type": "object",
  "required": ["id", "version", "purpose", "capabilities", "side_effects", "inputs", "outputs", "preconditions", "postconditions", "target_scope", "auth_source", "network_destinations", "data_classes", "idempotent", "retry", "cancellation", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"enum": ["read", "repo_write", "network_read", "external_write", "secret_read", "identity", "migration", "deploy", "financial", "destructive"]}, "uniqueItems": true},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "target_scope": {"type": "object", "required": ["class", "identifiers"], "properties": {"class": {"enum": ["repository", "workspace", "account", "service", "none"]}, "identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^*]+$"}}}, "additionalProperties": false},
    "auth_source": {"type": "string", "minLength": 1},
    "network_destinations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^[^*]+$"}},
    "data_classes": {"type": "array", "items": {"type": "string"}},
    "idempotent": {"type": "boolean"},
    "retry": {"type": "object", "required": ["max_attempts"], "properties": {"max_attempts": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "cancellation": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
